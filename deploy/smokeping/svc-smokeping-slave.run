#!/usr/bin/with-contenv bash
set -eu
# Foreground SmokePing skips daemonize_me(), including PID-file creation.
# exec keeps this PID stable so a probe can signal its real parent on reload.
: "${MASTER_URL:?slave MASTER_URL required}"
: "${SHARED_SECRET:?slave SHARED_SECRET required}"
: "${CACHE_DIR:?slave CACHE_DIR required}"
install -g abc -o abc -m 400 -D <(printf '%s\n' "$SHARED_SECRET") /var/smokeping/secret.txt
install -d -o abc -g abc "$CACHE_DIR"
printf '%s\n' "$$" > "$CACHE_DIR/smokeping.pid"
chown abc:abc "$CACHE_DIR/smokeping.pid"
exec s6-setuidgid abc /usr/sbin/smokeping \
    --master-url="$MASTER_URL" --cache-dir="$CACHE_DIR" \
    --pid-dir="$CACHE_DIR" --shared-secret=/var/smokeping/secret.txt --nodaemon
